//////////////////////////////////////////////////////////////////
// Minimal VEX two-byte opcode decodes for AVX subset.
//
// This file defines a distinct opcode state for VEX-encoded two-byte (0x0F)
// opcodes. Only a small AVX/AVX2 floating-point subset is implemented.

'X86ISA::TwoByteOpcodeVEX': decode OPCODE_OP {
    format Inst {
        // 0x58 ADD packed: PS (pp=00), PD (pp=01)
        0x58: decode VEX_PP {
            // PD
            0x1: decode VEX_L {
                // 128-bit: reg-reg vs mem
                0x0: decode MODRM_MOD {
                    0x3: VADDPD_128_XMM_XMM(Vo, Wo);
                    default: VADDPD_128_XMM_M(M);
                }
                // 256-bit: reg-reg vs mem
                0x1: decode MODRM_MOD {
                    0x3: VADDPD_256_XMM_XMM(Vo, Wo);
                    default: VADDPD_256_XMM_M(M);
                }
            }
            // PS
            0x0: decode VEX_L {
                0x0: decode MODRM_MOD {
                    0x3: VADDPS_XMM_XMM(Vo, Wo);
                    default: VADDPS_XMM_M(M);
                }
                0x1: decode MODRM_MOD {
                    0x3: VADDPS_YMM_YMM(Vo, Wo);
                    default: VADDPS_YMM_M(M);
                }
            }
        }

        // 0x59 MUL packed: PS (pp=00), PD (pp=01)
        0x59: decode VEX_PP {
            // PD
            0x1: decode VEX_L {
                0x0: decode MODRM_MOD {
                    0x3: VMULPD_128_XMM_XMM(Vo, Wo);
                    default: VMULPD_128_XMM_M(M);
                }
                0x1: decode MODRM_MOD {
                    0x3: VMULPD_256_XMM_XMM(Vo, Wo);
                    default: VMULPD_256_XMM_M(M);
                }
            }
            // PS
            0x0: decode VEX_L {
                0x0: decode MODRM_MOD {
                    0x3: VMULPS_XMM_XMM(Vo, Wo);
                    default: VMULPS_XMM_M(M);
                }
                0x1: decode MODRM_MOD {
                    0x3: VMULPS_YMM_YMM(Vo, Wo);
                    default: VMULPS_YMM_M(M);
                }
            }
        }

        // 0x5C SUB packed: PS (pp=00), PD (pp=01)
        0x5C: decode VEX_PP {
            // PD
            0x1: decode VEX_L {
                0x0: decode MODRM_MOD {
                    0x3: VSUBPD_128_XMM_XMM(Vo, Wo);
                    default: VSUBPD_128_XMM_M(M);
                }
                0x1: decode MODRM_MOD {
                    0x3: VSUBPD_256_XMM_XMM(Vo, Wo);
                    default: VSUBPD_256_XMM_M(M);
                }
            }
            // PS
            0x0: decode VEX_L {
                0x0: decode MODRM_MOD {
                    0x3: VSUBPS_128_XMM_XMM(Vo, Wo);
                    default: VSUBPS_128_XMM_M(M);
                }
                0x1: decode MODRM_MOD {
                    0x3: VSUBPS_256_XMM_XMM(Vo, Wo);
                    default: VSUBPS_256_XMM_M(M);
                }
            }
        }

        // 0x5E DIV packed: PS (pp=00), PD (pp=01)
        0x5E: decode VEX_PP {
            // PD
            0x1: decode VEX_L {
                0x0: decode MODRM_MOD {
                    0x3: VDIVPD_128_XMM_XMM(Vo, Wo);
                    default: VDIVPD_128_XMM_M(M);
                }
                0x1: decode MODRM_MOD {
                    0x3: VDIVPD_256_XMM_XMM(Vo, Wo);
                    default: VDIVPD_256_XMM_M(M);
                }
            }
            // PS
            0x0: decode VEX_L {
                0x0: decode MODRM_MOD {
                    0x3: VDIVPS_XMM_XMM(Vo, Wo);
                    default: VDIVPS_XMM_M(M);
                }
                0x1: decode MODRM_MOD {
                    0x3: VDIVPS_YMM_YMM(Vo, Wo);
                    default: VDIVPS_YMM_M(M);
                }
            }
        }

        // 0x12 MOVDDUP: duplicate low double(s) within 128-bit lanes
        // (F2 prefix)
        0x12: decode VEX_PP {
            0x3: decode VEX_L {
                // 256-bit MOVDDUP (YMM width; name uses 256_XMM_* convention)
                0x1: decode MODRM_MOD {
                    0x3: VMOVDDUP_256_XMM_XMM(Vo, Wo);
                    default: VMOVDDUP_256_XMM_M(M);
                }
                // 128-bit MOVDDUP
                0x0: decode MODRM_MOD {
                    0x3: VMOVDDUP_128_XMM_XMM(Vo, Wo);
                    default: VMOVDDUP_128_XMM_M(M);
                }
            }
            default: UD2();
        }

        // Simple moves (unchanged): VMOVUPS/VMOVAPS
        0x10: decode VEX_L {
            0x1: VMOVUPS_256(M);
            0x0: VMOVUPS_128(M);
        }
        0x11: decode VEX_L {
            0x1: VMOVUPS_M_256(M);
            0x0: VMOVUPS_M_128(M);
        }
        0x28: decode VEX_L {
            0x1: VMOVAPS_256(M);
            0x0: VMOVAPS_128(M);
        }
        0x29: decode VEX_L {
            0x1: VMOVAPS_M_256(M);
            0x0: VMOVAPS_M_128(M);
        }
        // FMA3 instructions live in 0F38 map; this file covers only 0F. See three_byte_opcodes_vex.isa for VFMADD231PS mapping.
        // VCMPPS (0xC2) requires an immediate (Ib).
        // The _I suffix is auto-generated by Inst format when Ib operand is present.
        0xC2: decode VEX_L {
            0x1: VCMPPS_256(Vo, Wo, Ib);
            0x0: VCMPPS_128(Vo, Wo, Ib);
        }
        0x77: VZEROUPPER();
        default: UD2();
    }
}
