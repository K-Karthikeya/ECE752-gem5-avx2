//////////////////////////////////////////////////////////////////
// Minimal VEX two-byte opcode decodes for AVX subset.
//
// This file defines a distinct opcode state for VEX-encoded two-byte (0x0F)
// opcodes. Only a small AVX/AVX2 floating-point subset is implemented.

'X86ISA::TwoByteOpcodeVEX': decode OPCODE_OP {
    format Inst {
        // Arithmetic ops: reg-reg forms STILL use ModRM (reg = dest, r/m = src2).
        // The ModRM byte is always present; we parse it to populate env.reg and
        // env.regm distinctly (needed so xmm0 dest and xmm0m src2 differ).
        // gem5 treats all reg-reg forms as implicit R forms (no M operand).
        0x58: decode VEX_L {
            // Reg-reg: use Vo (XMM reg via ModRM.reg) and Wo (XMM reg/mem via ModRM.r/m)
            0x1: VADDPS_YMM_YMM(Vo, Wo);
            0x0: VADDPS_XMM_XMM(Vo, Wo);
        }
        0x59: decode VEX_L {
            0x1: VMULPS_YMM_YMM(Vo, Wo);
            0x0: VMULPS_XMM_XMM(Vo, Wo);
        }
        0x57: decode VEX_L {
            0x1: VXORPS_YMM_YMM(Vo, Wo);
            0x0: VXORPS_XMM_XMM(Vo, Wo);
        }
        0x5C: decode VEX_L {
            // VSUBPS reg-reg (Vo dest, Wo src2)
            0x1: VSUBPS_YMM_YMM(Vo, Wo);
            0x0: VSUBPS_XMM_XMM(Vo, Wo);
        }
        0x54: decode VEX_L {
            // VANDPS reg-reg
            0x1: VANDPS_YMM_YMM(Vo, Wo);
            0x0: VANDPS_XMM_XMM(Vo, Wo);
        }
        0x5E: decode VEX_L {
            // VDIVPS reg-reg
            0x1: VDIVPS_YMM_YMM(Vo, Wo);
            0x0: VDIVPS_XMM_XMM(Vo, Wo);
        }
        // VMINPS (0x5D)
        0x5D: decode VEX_L {
            0x1: VMINPS_256_YMM_YMM(Vo, Wo);
            0x0: VMINPS_128_XMM_XMM(Vo, Wo);
        }
        // VMAXPS (0x5F)
        0x5F: decode VEX_L {
            0x1: VMAXPS_256_YMM_YMM(Vo, Wo);
            0x0: VMAXPS_128_XMM_XMM(Vo, Wo);
        }
        // Load from memory (M operand triggers doModRM via specializeInst)
        0x10: decode VEX_L {
            0x1: VMOVUPS_256_YMM(M);
            0x0: VMOVUPS_128_XMM(M);
        }
        // Store to memory (M operand triggers doModRM via specializeInst)
        0x11: decode VEX_L {
            0x1: VMOVUPS_256_M_YMM(M);
            0x0: VMOVUPS_128_M_XMM(M);
        }
        // VMOVSLDUP (0x12, VEX)
        0x12: decode VEX_L {
            0x1: VMOVSLDUP_256_YMM_YMM(Vo, Wo);
            0x0: VMOVSLDUP_128_XMM_XMM(Vo, Wo);
        }
        // VMOVSHDUP (0x16, VEX)
        0x16: decode VEX_L {
            0x1: VMOVSHDUP_256_YMM_YMM(Vo, Wo);
            0x0: VMOVSHDUP_128_XMM_XMM(Vo, Wo);
        }
        0x28: decode VEX_L {
            0x1: VMOVAPS_256_YMM(M);
            0x0: VMOVAPS_128_XMM(M);
        }
        0x29: decode VEX_L {
            0x1: VMOVAPS_256_M_YMM(M);
            0x0: VMOVAPS_128_M_XMM(M);
        }
        // FMA3 instructions live in 0F38 map; this file covers only 0F. See three_byte_opcodes_vex.isa for VFMADD231PS mapping.
        // VCMPPS (0xC2) requires an immediate (Ib).
        // The _I suffix is auto-generated by Inst format when Ib operand is present.
        0xC2: decode VEX_L {
            0x1: VCMPPS_YMM_YMM(Vo, Wo, Ib);
            0x0: VCMPPS_XMM_XMM(Vo, Wo, Ib);
        }
        0x77: VZEROUPPER_256();
        default: UD2();
    }
}
